{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "Chat Sounds",
  "description": "Plays a sound whenever a chat message is received.",
  "authors": [
    "AlurienFlame",
    "davidalb97",
    "Felix14-v2",
    "Binero",
    "Jerozgen"
  ],
  "contact": {
    "sources": "https://github.com/AlurienFlame/chatsounds"
  },
  "license": "MIT",
  "icon": "assets/chatsounds/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "io.github.alurienflame.chatsounds.Chatsounds"
    ],
    "modmenu": [
      "io.github.alurienflame.chatsounds.ModMenuIntegration"
    ]
  },
  "mixins": [
    "chatsounds.mixins.json"
  ],
  "depends": {
    "fabricloader": "^${loader_version}",
    "fabric-api": "^${fabric_api_version}",
    "minecraft": ">=${minecraft_version}",
    "java": ">=25",
    "modmenu": "*",
    "cloth-config": "^${cloth_config_version}"
  },
  "conflicts": {
    "replaymod": "*"
  },
  "custom": {
    "mc-publish": {
      "loaders": [
        "fabric"
      ]
    }
  }
}
